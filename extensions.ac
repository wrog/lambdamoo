# MOO_LIB_ICUUC( <IF-FOUND>, <IF-NOT-FOUND> )
#
AC_DEFUN([MOO_LIB_ICUUC],
[AC_CACHE_CHECK([[for icu being installed]],[moo_cv_icuuc_lib],[[
_moo_save_libs=$LIBS
moo_cv_icuuc_lib=
LIBS="-licuuc $_moo_save_libs"]
AC_LINK_IFELSE([AC_LANG_PROGRAM(
  [[@%:@include <unicode/uchar.h>]],
  [[UChar32 c; int j = u_charDigitValue(c);]])],[[
  moo_cv_icuuc_lib=yes
]],[[
  moo_cv_icuuc_lib=no
]])
LIBS=$_moo_save_libs])
AS_IF([[test "$moo_cv_icuuc_lib" = yes]],[[
  LIBS="-licuuc $LIBS"]
  $1],[$2])])

# MOO_LIB_PCRE2( <IF-FOUND>, <IF-NOT-FOUND>, <IF-BROKEN> )
#
AC_DEFUN([MOO_LIB_PCRE2],
[AC_CHECK_LIB([pcre2-8], [pcre2_match_8], [
AC_CACHE_CHECK([[whether -lpcre2-8 was built with required features]],
  [moo_lib_cv_pcre2_unicode],
[[_moo_save_libs=$LIBS
LIBS="-lpcre2-8 $LIBS"]
# A cross-built PCRE2 cannot be queried; a successful link is the best evidence.
AC_RUN_IFELSE([AC_LANG_PROGRAM([[@%:@ define PCRE2_CODE_UNIT_WIDTH 8
@%:@ include <pcre2.h>]],[[
  uint32_t have_unicode;
  pcre2_config(PCRE2_CONFIG_UNICODE, &have_unicode);
  return have_unicode ? 0 : 1;
]])], [[moo_lib_cv_pcre2_unicode=yes]], [[moo_lib_cv_pcre2_unicode=no]],
      [[moo_lib_cv_pcre2_unicode=yes]])[
LIBS=$_moo_save_libs]])
AS_IF([[test $moo_lib_cv_pcre2_unicode = yes]],[[
  LIBS="-lpcre2-8 $LIBS"]
  $1], [$3])], [[moo_lib_cv_pcre2_unicode=no]
$2])])

# MOO_LIB_PCRE1( <IF-FOUND>, <IF-NOT-FOUND>, <IF-BROKEN> )
#
AC_DEFUN([MOO_LIB_PCRE1],
[AC_CHECK_LIB([pcre], [pcre_exec], [
AC_CACHE_CHECK([[whether -lpcre was built with required features]],
  [moo_lib_cv_pcre_utf8],
[[_moo_save_libs=$LIBS
LIBS="-lpcre $LIBS"]
# A cross-built PCRE1 cannot be queried; a successful link is the best evidence.
AC_RUN_IFELSE([AC_LANG_PROGRAM([[@%:@ include <pcre.h>]],[[
  int have_utf8, have_props;
  pcre_config(PCRE_CONFIG_UTF8, &have_utf8);
  pcre_config(PCRE_CONFIG_UNICODE_PROPERTIES, &have_props);
  return (have_utf8 && have_props) ? 0 : 1;
]])], [[moo_lib_cv_pcre_utf8=yes]], [[moo_lib_cv_pcre_utf8=no]],
      [[moo_lib_cv_pcre_utf8=yes]])[
LIBS=$_moo_save_libs]])
AS_IF([[test $moo_lib_cv_pcre_utf8 = yes]],[[
  LIBS="-lpcre $LIBS"]
  $1], [$3])], [[moo_lib_cv_pcre_utf8=no]
$2])])

